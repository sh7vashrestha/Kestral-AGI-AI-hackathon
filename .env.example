# drone-brain settings. Copy to .env and edit.
# SAFETY: ALLOW_REAL_ARM must only ever be set to true by a human, on purpose.

DRY_RUN=true
ALLOW_REAL_ARM=false
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_TIMEOUT_S=60.0
LLM_RETRIES=2
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1
# chat assistant: max seconds per LLM turn before the "use the Survey tab" fallback message
ASSISTANT_TIMEOUT_S=45
MAVLINK_URL=udpin:0.0.0.0:14550
MAVLINK_BAUD=921600
MAVLINK_TIMEOUT_S=5.0
HEARTBEAT_LOSS_S=3.0
AUTOPILOT=ardupilot
# IMX477 CSI. Lens is ASSUMED 6 mm CS: set the real FOCAL_LENGTH_MM / HFOV / VFOV!
CAMERA_SOURCE=csi:0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAPTURE_FPS=1.0
CAMERA_HFOV_DEG=52.8
CAMERA_VFOV_DEG=31.2
SENSOR_WIDTH_MM=5.952
FOCAL_LENGTH_MM=6.0
IMAGE_WIDTH_PX=1920
SENSOR_HEIGHT_MM=3.348
# Image orientation applied at capture (rotate clockwise first, then flip). 90/270 make the frame 1080x1920 and swap
# the FOVs. The drone flies "up" the image: the image's horizontal axis is ACROSS-track. Preview on /live, then "Save as default".
CAMERA_ROTATE=180
CAMERA_FLIP=none
YOLO_MODEL=yolo26n.pt
YOLO_CONF_THRESHOLD=0.4
YOLO_IMGSZ=640
MATCH_BACKEND=clip
VLM_CONFIRM_TOP=false
MATCH_THRESHOLD=0.7
MIN_FRAMES=3
MATCH_STRONG_THRESHOLD=0.93
MATCH_MIN_PX=20
CROP_PADDING=0.2
CROP_MIN_PX=224
VLM_QUEUE_SIZE=32
ALERT_MIN_INTERVAL_S=5.0
TRACKER_IOU=0.3
TRACKER_GPS_RADIUS_M=8.0
SURVEY_OVERLAP=0.25
DEFAULT_ALT_M=20.0
DEFAULT_SPEED_MS=3.0
MAX_ALT_M=60.0
MIN_ALT_M=5.0
GEOFENCE_RADIUS_M=300.0
MAX_PATH_M=3000.0
MAX_SPEED_MS=10.0
MIN_PERSON_PX=80
# chat assistant: person height in px wanted per target detail level (person only / clothing colour / fine detail)
DETAIL_PX_PERSON=80
DETAIL_PX_CLOTHING=120
DETAIL_PX_FINE=160
PERSON_HEIGHT_M=1.7
WEB_HOST=0.0.0.0
WEB_PORT=8000
HTTPS=false                     # true: serve the app over HTTPS on HTTPS_PORT (scripts/make_cert.sh; README: HTTPS)
HTTPS_PORT=8443
DATA_DIR=./data
LOG_LEVEL=INFO

# --- Thermal (PureThermal / Lepton 3.x) ---
THERMAL_SOURCE=v4l2:/dev/v4l/by-id/usb-GroupGets_PureThermal__fw:v1.3.0__80020023-5103-3133-3332-373300000000-video-index0
THERMAL_HFOV_DEG=57.0
THERMAL_VFOV_DEG=44.0
THERMAL_ROTATE=0
THERMAL_FLIP=none
THERMAL_DELTA_C=4.0
THERMAL_MIN_C=24.0
THERMAL_MAX_C=42.0
THERMAL_MAX_AGE_S=0.5
THERMAL_WEIGHT=0.5
THERMAL_RECHECK_CONF=0.35
THERMAL_STUCK_PIXELS=67,64
RGB_DARK_THRESHOLD=25

# --- Phase 7: vehicle mode + airspace ---
# sim | readonly | upload | full  (readonly = real Pixhawk telemetry + param reads only;
# upload = readonly + mission upload/verify/clear for review in Mission Planner/QGC, never arms/flies)
VEHICLE_MODE=sim
UPLOAD_FENCE_POLYGON=false
# Indoor upload TEST only (VEHICLE_MODE=upload; any other mode refuses to start): plan with this home while the Pixhawk
# has no GPS home. "LAT,LON[,AMSL]" or "field" (KSU soccer field centre). A real Pixhawk home always wins.
BENCH_HOME=
# Altitude approved in the LAANC authorization for this flight (empty = none; ceiling is then MAX_ALT_M / 120 m)
# LAANC_CEILING_M=45
OBSTACLE_CLEARANCE_M=15
HOME_SHIFT_REPLAN_M=5
HOME_ALT_SHIFT_M=2
# CLIP match cut-off (sum of positive-prompt probabilities). Untuned: AUC 0.94 but accuracy 0.62 at 0.5
CLIP_MATCH_CUTOFF=0.6
CLIP_PROMPTS_LLM=true
